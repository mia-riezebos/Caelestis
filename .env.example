# Generate a private token with: openssl rand -hex 32
ADMIN_TOKEN=
SERVER_NAME=Caelestis
SEASON=0

# SQLite and filesystem objects persist together in the Compose data volume.
DB_ADAPTER=sqlite
OBJECT_STORAGE=filesystem

# Public origin when serving through an HTTPS proxy:
# ORIGIN=https://caelestis.example.com
CAELESTIS_BIND_ADDRESS=127.0.0.1
CAELESTIS_HTTP_PORT=3000

# Override to run a published image with docker compose up --no-build.
# CAELESTIS_IMAGE=registry/namespace/caelestis:VERSION

# PostgreSQL/CNPG and S3 can be selected independently. See docs/self-hosting.md.
# DATABASE_URL=postgresql://user:password@postgres.example.com:5432/caelestis
# PG_TLS_MODE=verify-full
# S3_BUCKET=caelestis
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
