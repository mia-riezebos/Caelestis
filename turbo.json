{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["CAELESTIS_TARGET", "CAELESTIS_BUILD_ID", "VITE_CAELESTIS_SERVER"],
      "outputs": ["dist/**", "build/**", ".svelte-kit/cloudflare/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
