{
  "name": "wplace-template-server",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo run dev",
    "check": "turbo check",
    "test": "turbo test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "clean": "turbo clean && rm -rf node_modules",
    "inject": "pnpm --filter @wts/userscript inject",
    "inject:watch": "pnpm --filter @wts/userscript inject:watch",
    "browser": "pnpm --filter @wts/userscript browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
