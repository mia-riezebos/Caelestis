{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.turbo",
      "!**/.wrangler",
      "!**/worker-configuration.d.ts",
      "!**/pnpm-lock.yaml",
      "!.scratch",
      "!.claude",
      "!**/migrations/meta",
      "!**/migrations/**/*.sql",
      "!fixtures/berrycamp/wplace-templates",
      "!**/.svelte-kit",
      "!**/*.svelte",
      "!apps/frontend/src/app.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/stack-tests/**",
        "scripts/test-portable-compose.mjs",
        "scripts/test-helm-stack.mjs",
        "scripts/test-cloudflare-stack.mjs",
        "scripts/test-cloudflare-remote.mjs"
      ],
      "linter": { "rules": { "suspicious": { "noUndeclaredEnvVars": "off" } } }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
