{
  "name": "@caelestis/backend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.bun.json",
    "start:node": "cd ../.. && node apps/backend/dist/node/main.js",
    "start:bun": "cd ../.. && bun apps/backend/dist/node/main.js",
    "check": "tsc -p tsconfig.check.json && tsc -p tsconfig.bun.json --noEmit && tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "dev": "pnpm db:migrate:local && node dev.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:docker": "node scripts/test-integration-docker.mjs",
    "test:runtime": "vitest run --config vitest.runtime.config.ts && bun --bun node_modules/vitest/vitest.mjs run --config vitest.runtime.config.ts",
    "test:d1": "vitest run --config vitest.d1.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@caelestis/shared": "workspace:*",
    "@caelestis/storage": "workspace:*",
    "@caelestis/wire-schema": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-beta.102",
    "fzstd": "0.1.1",
    "hono": "^4.6.0",
    "mariadb": "^3.5.4",
    "pg": "^8.23.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@types/bun": "1.4.2",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.24.2",
    "miniflare": "4.20260730.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.131.0"
  }
}
