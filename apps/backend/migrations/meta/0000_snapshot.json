        "template_versions_bounds_all_or_none_check": {
          "name": "template_versions_bounds_all_or_none_check",
          "value": "(\"template_versions\".\"bounds_north\" IS NULL AND \"template_versions\".\"bounds_south\" IS NULL AND \"template_versions\".\"bounds_west\" IS NULL AND \"template_versions\".\"bounds_east\" IS NULL) OR (\"template_versions\".\"bounds_north\" IS NOT NULL AND \"template_versions\".\"bounds_south\" IS NOT NULL AND \"template_versions\".\"bounds_west\" IS NOT NULL AND \"template_versions\".\"bounds_east\" IS NOT NULL)"
        },
        "template_versions_pixel_bounds_check": {
          "name": "template_versions_pixel_bounds_check",
          "value": "typeof(\"template_versions\".\"min_x\") = 'integer' AND typeof(\"template_versions\".\"min_y\") = 'integer'\n        AND typeof(\"template_versions\".\"max_x\") = 'integer' AND typeof(\"template_versions\".\"max_y\") = 'integer'\n        AND typeof(\"template_versions\".\"total_pixels\") = 'integer'\n        AND \"template_versions\".\"min_x\" BETWEEN 0 AND 2047999\n        AND \"template_versions\".\"min_y\" BETWEEN 0 AND 2047999\n        AND \"template_versions\".\"max_x\" BETWEEN 1 AND 2048000\n        AND \"template_versions\".\"max_y\" BETWEEN 1 AND 2048000\n        AND \"template_versions\".\"min_x\" <> \"template_versions\".\"max_x\"\n        AND \"template_versions\".\"min_y\" < \"template_versions\".\"max_y\"\n        AND \"template_versions\".\"total_pixels\" >= 0"
        },
        "template_versions_bounds_range_check": {
          "name": "template_versions_bounds_range_check",
          "value": "\"template_versions\".\"bounds_north\" IS NULL OR (\"template_versions\".\"bounds_north\" BETWEEN -90 AND 90 AND \"template_versions\".\"bounds_south\" BETWEEN -90 AND 90 AND \"template_versions\".\"bounds_west\" BETWEEN -180 AND 180 AND \"template_versions\".\"bounds_east\" BETWEEN -180 AND 180 AND \"template_versions\".\"bounds_north\" > \"template_versions\".\"bounds_south\")"
        }
      }
