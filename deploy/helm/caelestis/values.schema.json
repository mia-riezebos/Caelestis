{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "database": {
      "type": "object",
      "properties": {
        "adapter": { "enum": ["sqlite", "postgres"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": {
          "type": "object",
          "properties": { "mode": { "enum": ["verify-full", "require", "disable"] } }
        }
      }
    },
    "storage": { "type": "object", "properties": { "adapter": { "enum": ["filesystem", "s3"] } } },
    "server": {
      "type": "object",
      "properties": {
        "season": { "type": "integer", "minimum": 0 },
        "openAccess": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
