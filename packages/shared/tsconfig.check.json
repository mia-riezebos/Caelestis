{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Only the tests reach for node: builtins — the codec fixtures deflate with node:zlib so the
    // decoder is checked against bytes the platform stream did not produce. The published build
    // must not see these, which is why they are here and not in tsconfig.json.
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": []
}
